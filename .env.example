# Link raw GitHub hoặc nguồn TXT/JSON riêng. Không push .env thật lên GitHub.
TIKTOK_60_SOURCE_URL=https://raw.githubusercontent.com/USER/REPO/main/videos/tiktok-60p.txt
TIKTOK_180_SOURCE_URL=https://raw.githubusercontent.com/USER/REPO/main/videos/tiktok-180p.txt
TIKTOK_LITE_60_SOURCE_URL=https://raw.githubusercontent.com/USER/REPO/main/videos/tiktok-lite-60p.txt
TIKTOK_LITE_180_SOURCE_URL=https://raw.githubusercontent.com/USER/REPO/main/videos/tiktok-lite-180p.txt

TIKTOK_10_SOURCE_URL=
TIKTOK_LITE_10_SOURCE_URL=

# Link chia sẻ iCloud của phím tắt iPhone. Tạo phím tắt một lần, bấm Share -> Copy iCloud Link rồi dán vào Render Environment.
SHORTCUT_TIKTOK_60_URL=
SHORTCUT_TIKTOK_180_URL=
SHORTCUT_TIKTOK_LITE_60_URL=
SHORTCUT_TIKTOK_LITE_180_URL=

# Mở TikTok Lite bằng URL scheme. Nếu app không mở, đổi template hoặc để trống để dùng web URL.
TIKTOK_LITE_OPEN_TEMPLATE=snssdk1340://aweme/detail/{id}
# Mở TikTok thường bằng scheme riêng nếu cần. Để trống sẽ dùng web URL.
TIKTOK_APP_OPEN_TEMPLATE=
